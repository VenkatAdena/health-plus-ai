# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — secrets never reach the repository.

# --- LLM ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# --- Application (all optional, sensible defaults exist) ---
HEALTHPLUS_ENVIRONMENT=development
HEALTHPLUS_DEBUG=false
HEALTHPLUS_LOG_LEVEL=INFO

# --- Claude model ---
HEALTHPLUS_CLAUDE_MODEL=claude-sonnet-5
HEALTHPLUS_CLAUDE_MAX_TOKENS=1024

# --- OpenAI model ---
HEALTHPLUS_OPENAI_MODEL=gpt-4o-mini

# --- Retrieval / RAG ---
HEALTHPLUS_RETRIEVAL_TOP_K=5
HEALTHPLUS_RETRIEVAL_MIN_SCORE=0.30
HEALTHPLUS_CONTEXT_MAX_CHARS=8000

# --- Conversation ---
HEALTHPLUS_MEMORY_MAX_TURNS=10

# --- Storage paths (relative to project root) ---
HEALTHPLUS_DATA_DIR=data
HEALTHPLUS_LOG_DIR=logs

# --- Knowledge base ---
HEALTHPLUS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HEALTHPLUS_CHROMA_COLLECTION=healthplus_documents
HEALTHPLUS_CHUNK_SIZE=1000
HEALTHPLUS_CHUNK_OVERLAP=200
